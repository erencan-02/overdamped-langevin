{
  "name": "langevin-dynamics",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive real-time simulator of the overdamped Langevin SDE dX = -grad Psi(X) dt + sigma dW on a paintable 2D potential landscape.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.185.1",
    "fflate": "0.8.2",
    "katex": "0.16.25"
  }
}
