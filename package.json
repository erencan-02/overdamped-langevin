{
  "name": "langevin-dynamics",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive real-time simulator of the overdamped Langevin SDE dX = -grad Psi(X) dt + sigma dW on a paintable 2D potential landscape.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/katex": "^0.16.7",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.185.1",
    "fflate": "0.8.2",
    "gifenc": "1.0.3",
    "katex": "0.16.25",
    "mediabunny": "1.62.1",
    "svgcanvas": "2.6.0",
    "three": "0.186.0",
    "valibot": "1.5.0"
  }
}
